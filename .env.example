# AeroAdd — ejemplo de variables de entorno
# Copia este archivo a .env para uso local. El archivo .env no se sube al repositorio.
#
# Los tokens de servicio NO se rellenan a mano: los genera el compose al arrancar
# (influx-tokens-init crea los de InfluxDB y grafana-sa-init los de las service
# accounts de Grafana) y se comparten por el volumen mcp-secrets.

# --- InfluxDB ---
INFLUXDB_CONTAINER_NAME=aeroadd-influxdb
INFLUXDB_PORT=8086
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=somo
# Ojo: evitar que empiece por '-' (rompe el `influx setup` del contenedor).
# Sustituye el placeholder CAMBIAME por tu contraseña (o ejecuta scripts/setup-env.sh,
# que genera todas las credenciales aleatorias sin escribir nada a mano).
INFLUXDB_INIT_PASSWORD=CAMBIAME
INFLUXDB_INIT_ORG=AeroAdd
INFLUXDB_INIT_BUCKET=initial_bucket
# Token admin con el que se inicializa la instancia local (usado por influx-tokens-init).
INFLUXDB_ADMIN_TOKEN=
INFLUXDB_EXTRA_BUCKETS=captaciones_julio,captaciones_tiemporeal,contexto_madrid,dataset_integrado

# --- Buckets de cada token de mínimo privilegio (lo genera influx-tokens-init) ---
GRAFANA_READ_BUCKETS=captaciones_julio,captaciones_tiemporeal,contexto_madrid
NODERED_WRITE_BUCKETS=captaciones_tiemporeal,contexto_madrid
LOADER_WRITE_BUCKETS=captaciones_julio

# --- Carga del histórico con el loader (hook automático en docker compose up) ---
LOADER_CSV=/data/captaciones_junio_2026.csv
LOADER_TZ=Europe/Madrid
# Fallback opcional: token de escritura del loader si no usas el token automático.
LOADER_INFLUXDB_TOKEN=

# --- Grafana ---
GRAFANA_CONTAINER_NAME=aeroadd-grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin
# Sustituye el placeholder CAMBIAME (o generada por scripts/setup-env.sh).
GRAFANA_ADMIN_PASSWORD=CAMBIAME

# --- Node-RED ---
NODERED_CONTAINER_NAME=aeroadd-nodered
NODERED_PORT=1880
# Clave de AeroDataBox/RapidAPI para el pipeline de llegadas (la lee el flow
# del contenedor vía variable de entorno; sin ella ese pipeline queda inactivo).
RAPIDAPI_KEY=

# --- Loader ---
LOADER_CONTAINER_NAME=aeroadd-loader

# --- MCP de Grafana: una instancia por rol ---
# URL de Grafana vista desde los contenedores MCP/init.
GRAFANA_URL=http://grafana:3000
# Rol de las service accounts mientras no exista RBAC fino (las crea grafana-sa-init).
GRAFANA_SA_ROLE=Viewer
# Nombres de las service accounts (una por rol).
GRAFANA_SA_DIRECCION_NAME=direccion
GRAFANA_SA_ANALISIS_NAME=analisis
GRAFANA_SA_IT_NAME=it
# Ficheros de token dentro del volumen compartido mcp-secrets (los escribe el init).
GRAFANA_SA_DIRECCION_TOKEN_FILE=/shared/sa-direccion-token
GRAFANA_SA_ANALISIS_TOKEN_FILE=/shared/sa-analisis-token
GRAFANA_SA_IT_TOKEN_FILE=/shared/sa-it-token
# Instancias MCP (misma imagen, un puerto por rol).
MCP_DIRECCION_CONTAINER_NAME=aeroadd-mcp-direccion
MCP_ANALISIS_CONTAINER_NAME=aeroadd-mcp-analisis
MCP_IT_CONTAINER_NAME=aeroadd-mcp-it
MCP_DIRECCION_PORT=8000
MCP_ANALISIS_PORT=8001
MCP_IT_PORT=8002
# Hosts HTTP aceptados por las instancias MCP (el servidor valida el header Host;
# sin esto responde 403). Si el cliente usa otro hostname (LAN, nombre de contenedor),
# añádelo aquí separado por comas.
MCP_ALLOWED_HOSTS=localhost:8000,localhost:8001,localhost:8002,127.0.0.1:8000,127.0.0.1:8001,127.0.0.1:8002,[::1]:8000,[::1]:8001,[::1]:8002
# Tokens de llamante por rol (auth hacia cada instancia MCP; distintos entre sí).
MCP_GRAFANA_SERVER_TOKEN_DIRECCION=CHANGEME
MCP_GRAFANA_SERVER_TOKEN_ANALISIS=CHANGEME
MCP_GRAFANA_SERVER_TOKEN_IT=CHANGEME
GRAFANA_SA_INIT_CONTAINER_NAME=aeroadd-grafana-sa-init
INFLUX_TOKENS_INIT_CONTAINER_NAME=aeroadd-influx-tokens-init
