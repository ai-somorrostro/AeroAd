# AeroAdd — ejemplo de variables de entorno
# Copia este archivo a .env para uso local. El archivo .env no se sube al repositorio.
# TODO: rellenar a mano todos los valores antes de levantar la pila. Sin secretos reales aquí.

# --- InfluxDB (TODO: rellenar a mano) ---
INFLUXDB_CONTAINER_NAME=aeroadd-influxdb
INFLUXDB_PORT=8086
INFLUXDB_URL=http://influxdb:8086
INFLUXDB_INIT_MODE=setup
INFLUXDB_INIT_USERNAME=ejemplo-usuario
INFLUXDB_INIT_PASSWORD=CHANGEME
INFLUXDB_INIT_ORG=ejemplo-org
INFLUXDB_INIT_BUCKET=ejemplo-bucket
INFLUXDB_ADMIN_TOKEN=CHANGEME
INFLUXDB_EXTRA_BUCKETS=CAMBIAME-bucket-2,CAMBIAME-bucket-3

# --- Grafana (TODO: rellenar a mano) ---
GRAFANA_CONTAINER_NAME=aeroadd-grafana
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=ejemplo-usuario
GRAFANA_ADMIN_PASSWORD=CHANGEME

# --- Node-RED (TODO: rellenar a mano) ---
NODERED_CONTAINER_NAME=aeroadd-nodered
NODERED_PORT=1880

# --- Loader (TODO: rellenar a mano) ---
LOADER_CONTAINER_NAME=aeroadd-loader

# --- MCP (TODO: rellenar a mano) ---
MCP_CONTAINER_NAME=aeroadd-mcp
MCP_PORT=8000
