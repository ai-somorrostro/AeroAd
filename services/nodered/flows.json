[
  {
    "id": "aeroadd-tab-smoke",
    "type": "tab",
    "label": "InfluxDB smoke test",
    "disabled": false,
    "info": "Escribe un punto de prueba en InfluxDB (API v2 /write) con URL, org, bucket y token del entorno."
  },
  {
    "id": "aeroadd-inject-smoke",
    "type": "inject",
    "z": "aeroadd-tab-smoke",
    "name": "punto de prueba",
    "props": [{ "p": "payload" }],
    "repeat": "300",
    "crontab": "",
    "once": true,
    "onceDelay": "10",
    "topic": "",
    "payload": "",
    "payloadType": "date",
    "x": 150,
    "y": 100,
    "wires": [["aeroadd-fn-smoke"]]
  },
  {
    "id": "aeroadd-fn-smoke",
    "type": "function",
    "z": "aeroadd-tab-smoke",
    "name": "line protocol",
    "func": "msg.payload = \"test,source=nodered value=1i\";\nreturn msg;",
    "outputs": 1,
    "timeout": 0,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": [],
    "x": 340,
    "y": 100,
    "wires": [["aeroadd-http-smoke"]]
  },
  {
    "id": "aeroadd-http-smoke",
    "type": "http request",
    "z": "aeroadd-tab-smoke",
    "name": "write InfluxDB",
    "method": "POST",
    "ret": "txt",
    "paytoqs": "ignore",
    "url": "$(INFLUXDB_URL)/api/v2/write?org=$(INFLUXDB_ORG)&bucket=$(INFLUXDB_BUCKET)&precision=s",
    "tls": "",
    "persist": false,
    "proxy": "",
    "insecureHTTPParser": false,
    "authType": "",
    "senderr": false,
    "headers": [
      { "keyType": "other", "keyValue": "Authorization", "valueType": "other", "valueValue": "Token $(INFLUXDB_TOKEN)" },
      { "keyType": "other", "keyValue": "Content-Type", "valueType": "other", "valueValue": "text/plain; charset=utf-8" }
    ],
    "x": 540,
    "y": 100,
    "wires": [["aeroadd-debug-smoke"]]
  },
  {
    "id": "aeroadd-debug-smoke",
    "type": "debug",
    "z": "aeroadd-tab-smoke",
    "name": "respuesta",
    "active": true,
    "tosidebar": true,
    "console": false,
    "tostatus": false,
    "complete": "statusCode",
    "targetType": "msg",
    "statusVal": "",
    "statusType": "auto",
    "x": 730,
    "y": 100,
    "wires": []
  }
]
