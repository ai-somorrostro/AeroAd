{
  "$schema": "https://opencode.ai/config.json",
  "mcp": {
    "grafana-direccion": {
      "type": "remote",
      "url": "http://localhost:8000/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:MCP_GRAFANA_SERVER_TOKEN_DIRECCION}"
      }
    },
    "grafana-analisis": {
      "type": "remote",
      "url": "http://localhost:8001/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:MCP_GRAFANA_SERVER_TOKEN_ANALISIS}"
      }
    },
    "grafana-it": {
      "type": "remote",
      "url": "http://localhost:8002/mcp",
      "enabled": true,
      "oauth": false,
      "headers": {
        "Authorization": "Bearer {env:MCP_GRAFANA_SERVER_TOKEN_IT}"
      }
    }
  }
}
